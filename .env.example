# ED Arcade — Supabase (OPCIONAL)
# Copia este archivo como .env.local y llena los valores de tu proyecto
# (Supabase → Project Settings → API). Antes, corre supabase/schema.sql en el SQL Editor.
# Sin estas variables el juego funciona en MODO LOCAL (progreso solo en este navegador).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
